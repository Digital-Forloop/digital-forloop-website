---
interface Props {
  appStore?: string;
  playStore?: string;
}
const { appStore, playStore } = Astro.props;
---

<div class="store-buttons">
  {appStore && (
    <a href={appStore} class="store-btn app-store" target="_blank" rel="noopener">
      Download on the App Store
    </a>
  )}
  {playStore && (
    <a href={playStore} class="store-btn play-store" target="_blank" rel="noopener">
      Get it on Google Play
    </a>
  )}
</div>

<style>
  .store-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 1.5rem 0;
  }
  .store-btn {
    display: inline-block;
    padding: 0.875rem 1.5rem;
    background: #1a1a1a;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: transform 0.15s ease;
  }
  .store-btn:hover { transform: translateY(-2px); }
</style>