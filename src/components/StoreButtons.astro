---
import { Image } from 'astro:assets';
import appStoreBadge from '../../public/badges/app-store.svg';
import googlePlayBadge from '../../public/badges/google-play.png';

interface Props {
  appStore?: string;
  playStore?: string;
}
const { appStore, playStore } = Astro.props;
---

<div class="store-buttons">
  {appStore && (
    <a href={appStore} target="_blank" rel="noopener" class="store-badge-link">
      <Image src={appStoreBadge} alt="Download on the App Store" class="store-badge app-store-badge" height={48} />
    </a>
  )}
  {playStore && (
    <a href={playStore} target="_blank" rel="noopener" class="store-badge-link">
      <Image src={googlePlayBadge} alt="Get it on Google Play" class="store-badge google-play-badge" height={71} />
    </a>
  )}
</div>

<style>
  .store-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
    margin: 1.5rem 0;
  }
  .store-badge-link {
    display: inline-block;
    transition: opacity 0.15s ease;
  }
  .store-badge-link:hover { opacity: 0.85; }
  .store-badge { display: block; }
  .app-store-badge { height: 48px; width: auto; }
  .google-play-badge { height: 71px; width: auto; }
</style>