---
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/brand.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "Indie mobile games studio", ogImage } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : new URL('/assets/og-image.svg', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="apple-touch-icon" href="/assets/icon.svg" />
    <link rel="mask-icon" href="/assets/favicon.svg" color="#1F4E66" />
    <meta name="theme-color" content="#F4F1EA" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <header>
      <nav>
        <a href="/" class="site-logo" aria-label="Digital Forloop">
          <span class="logo-mark" aria-hidden="true">
            <span class="logo-bracket">[</span><span id="logo-typed"></span><span id="logo-cursor" class="logo-cursor"></span><span class="logo-bracket">]</span>
          </span>
        </a>
        <div class="nav-links">
          <a href="/">Games</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Digital Forloop</p>
      <p class="company-info">
        DIGITAL FORLOOP LIMITED No. 15958356 &mdash; England &amp; Wales<br />
        71-75 Shelton Street, Covent Garden, London, United Kingdom, WC2H 9JQ<br />
        Email: info at digitalforloop dot com
      </p>
      <p class="footer-links">
        <a href="/terms">Terms &amp; Conditions</a>
        &nbsp;&middot;&nbsp;
        <a href="/privacy">Privacy Policy</a>
        &nbsp;&middot;&nbsp;
        <button id="footer-manage-cookies" class="footer-cookie-btn">Manage Preferences</button>
      </p>
    </footer>

    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      .skip-to-content {
        position: absolute;
        top: -100%;
        left: 1rem;
        padding: 0.5rem 1rem;
        background: var(--df-navy);
        color: var(--df-cream);
        border-radius: 0 0 var(--df-radius-sm) var(--df-radius-sm);
        font-family: var(--df-mono);
        font-weight: 600;
        font-size: var(--df-text-sm);
        text-decoration: none;
        z-index: 99999;
        transition: top 0.1s;
      }
      .skip-to-content:focus { top: 0; }

      header {
        padding: 1.25rem 2rem;
        border-bottom: 1px solid var(--df-rule);
        background: var(--df-surface);
      }
      nav {
        display: flex;
        align-items: center;
        max-width: var(--df-container);
        margin: 0 auto;
      }

      /* ── Animated logo (typewriter) ────────────────────── */
      .site-logo {
        display: flex;
        align-items: center;
        margin-right: auto;
        text-decoration: none;
      }
      .logo-mark {
        display: inline-flex;
        align-items: center;
        font-family: var(--df-mono);
        font-size: 1.5rem;
        line-height: 1;
      }
      .logo-bracket {
        color: var(--df-navy);
        font-weight: 300;
        font-size: 1.9em;
        line-height: 1;
      }
      #logo-typed {
        font-weight: 600;
        letter-spacing: var(--df-tracking-mono);
      }
      #logo-typed .ch-navy { color: var(--df-navy); }
      #logo-typed .ch-teal { color: var(--df-teal); }
      .logo-cursor {
        display: inline-block;
        width: 0.5ch;
        height: 0.9em;
        background: var(--df-teal);
        margin: 0 1px;
        transform: translateY(0.08em);
        opacity: 0;
      }
      .logo-cursor.blinking {
        animation: dfBlink 0.9s steps(1) infinite;
      }
      @keyframes dfBlink {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
      }
      /* ───────────────────────────────────────────────────── */

      .nav-links {
        display: flex;
        gap: 1.5rem;
      }
      .nav-links a {
        color: var(--df-text-muted);
        text-decoration: none;
        font-size: var(--df-text-base);
        font-weight: 500;
        transition: color var(--df-dur-fast) var(--df-ease);
      }
      .nav-links a:hover { color: var(--df-teal); }

      main {
        max-width: var(--df-container);
        margin: 0 auto;
        padding: 2rem;
        min-height: calc(100vh - 140px);
      }

      footer {
        padding: 2rem;
        text-align: center;
        color: var(--df-text-muted);
        border-top: 1px solid var(--df-rule);
        font-size: var(--df-text-sm);
      }
      footer .company-info {
        margin-top: 0.5rem;
        font-size: var(--df-text-xs);
        color: var(--df-text-muted);
        line-height: 1.8;
      }
      footer .footer-links {
        margin-top: 0.75rem;
        font-size: var(--df-text-xs);
      }
      footer .footer-links a {
        color: var(--df-text-muted);
        text-decoration: none;
        transition: color var(--df-dur-fast) var(--df-ease);
      }
      footer .footer-links a:hover { color: var(--df-teal); }
      .footer-cookie-btn {
        background: none;
        border: none;
        color: var(--df-text-muted);
        font-size: var(--df-text-xs);
        cursor: pointer;
        padding: 0;
        font-family: inherit;
        transition: color var(--df-dur-fast) var(--df-ease);
      }
      .footer-cookie-btn:hover { color: var(--df-teal); }

      a { color: var(--df-teal); }
      img { max-width: 100%; height: auto; display: block; }
    </style>
    <CookieBanner />
    <script>
      document.getElementById('footer-manage-cookies')?.addEventListener('click', () => {
        document.getElementById('cookie-modal')!.hidden = false;
        document.getElementById('cookie-banner')!.hidden = true;
      });
    </script>
    <script>
      (() => {
        const typed = document.getElementById('logo-typed');
        const cursor = document.getElementById('logo-cursor');
        if (!typed || !cursor) return;

        const chars = 'digitalforloop'.split('');

        // Cursor appears first
        setTimeout(() => {
          cursor.classList.add('blinking');

          // Then type one character at a time
          chars.forEach((ch, i) => {
            setTimeout(() => {
              const span = document.createElement('span');
              span.textContent = ch;
              span.className = i < 7 ? 'ch-navy' : 'ch-teal';
              typed.appendChild(span);
            }, (i + 1) * 100);
          });
        }, 300);
      })();
    </script>
  </body>
</html>
