---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Digital Forloop" description="Digital Forloop is an independent mobile games studio based in London.">
  <article class="about">
    <p class="eyebrow">about</p>
    <h1>Digital Forloop</h1>

    <p>Digital Forloop is an independent mobile games studio based in London, England. We make games for iOS and Android that are built to be enjoyed — no fuss, no bloat, just games worth playing.</p>

    <p>Our debut title, <a href="/games/pixel-soccer-manager/">Pixel Soccer Manager</a>, is a football management game for mobile — a modern take on the classic text-based management games that many of us grew up with.</p>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: 640px;
    padding: 4rem 0;
  }
  .eyebrow {
    font-family: var(--df-mono);
    font-size: var(--df-text-xs);
    letter-spacing: var(--df-tracking-eyebrow);
    text-transform: uppercase;
    color: var(--df-teal);
    margin-bottom: 1rem;
  }
  h1 {
    font-size: var(--df-text-2xl);
    font-weight: 700;
    letter-spacing: var(--df-tracking-tight);
    color: var(--df-navy);
    line-height: 1.05;
    margin-bottom: 1.75rem;
  }
  p {
    font-size: var(--df-text-md);
    color: var(--df-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  a {
    color: var(--df-teal);
    text-decoration: none;
    font-weight: 500;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
