---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — Digital Forloop">
  <section class="not-found">
    <h1>404</h1>
    <p>This page doesn't exist or has been moved.</p>
    <a href="/">Back to home →</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 6rem 2rem;
  }
  h1 {
    font-size: 6rem;
    font-weight: 700;
    color: #eee;
    line-height: 1;
    margin-bottom: 1rem;
  }
  p {
    font-size: 1.25rem;
    color: #666;
    margin-bottom: 2rem;
  }
  a {
    font-weight: 600;
    font-size: 1rem;
  }
</style>
