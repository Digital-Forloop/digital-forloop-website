---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const { Content } = await render(game);
---

<BaseLayout title={`${game.data.title} — Digital Forloop`} description={game.data.tagline} ogImage={game.data.hero}>
  <article class="game-page">
    <header class="game-header">
      <img src={game.data.icon} alt={game.data.title} class="game-icon" width="96" height="96" loading="eager" decoding="async" />
      <div class="game-header-text">
        <img src="/games/pixel-soccer-manager/logo-horizontal.svg" alt={game.data.title} class="game-logo" loading="eager" decoding="async" />
        <p class="tagline">{game.data.tagline}</p>
        <StoreButtons
          appStore={game.data.storeLinks?.appStore}
          playStore={game.data.storeLinks?.playStore}
        />
      </div>
    </header>

    <YouTubeEmbed videoId={game.data.youtubeId} title={game.data.title} />

    <section class="content-section">
      <h2>About</h2>
      <p class="description">{game.data.description}</p>
      <Content />
    </section>

    <section class="content-section">
      <h2>Screenshots</h2>
      <ScreenshotGallery
        screenshots={game.data.screenshots}
        gameTitle={game.data.title}
      />
    </section>

    <section class="content-section community">
      <h2>Join the Community</h2>
      <p>
        We build {game.data.title} with our players. Join our Discord to share feedback,
        vote on upcoming features, report bugs, and be part of shaping the game's future.
      </p>
      <a href="https://discord.gg/VWWhfhj9" class="btn-primary" target="_blank" rel="noopener">
        Join our Discord →
      </a>
    </section>

    <section class="content-section">
      <h2>Press</h2>
      <p>
        Writing about {game.data.title}? Download our press kit with
        logos, screenshots, and key art.
      </p>
      <a href={game.data.pressPackUrl} class="btn-ghost" target="_blank" rel="noopener">
        Download Press Kit →
      </a>
    </section>
  </article>
</BaseLayout>

<style>
  .game-page { padding: 2.5rem 0 4rem; }

  .game-header {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }
  .game-icon {
    width: 96px;
    height: 96px;
    border-radius: 20px;
    box-shadow: var(--df-shadow);
    flex-shrink: 0;
  }
  .game-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .game-logo {
    max-width: 300px;
    height: auto;
    display: block;
  }
  .tagline {
    font-size: var(--df-text-md);
    color: var(--df-text-muted);
    line-height: 1.4;
  }

  .content-section {
    margin: 3rem 0;
    padding-top: 3rem;
    border-top: 1px solid var(--df-rule);
  }
  .content-section:first-of-type {
    margin-top: 0;
  }
  h2 {
    font-size: var(--df-text-xl);
    font-weight: 700;
    letter-spacing: var(--df-tracking-tight);
    color: var(--df-navy);
    margin-bottom: 1rem;
  }
  .description {
    font-size: var(--df-text-md);
    color: var(--df-text-muted);
    line-height: 1.65;
    max-width: 72ch;
    margin-bottom: 1rem;
  }
  .content-section :global(p) {
    font-size: var(--df-text-base);
    color: var(--df-text-muted);
    line-height: 1.65;
    margin-bottom: 0.75rem;
    max-width: 72ch;
  }
  .content-section :global(h2) {
    font-size: var(--df-text-lg);
    font-weight: 600;
    letter-spacing: var(--df-tracking-tight);
    color: var(--df-navy);
    margin: 2rem 0 0.5rem;
  }
  .content-section :global(ul) {
    padding-left: 1.25rem;
    color: var(--df-text-muted);
    font-size: var(--df-text-base);
    line-height: 1.7;
  }
  .content-section :global(li) {
    margin-bottom: 0.4rem;
  }
  .content-section :global(strong) {
    color: var(--df-navy);
    font-weight: 600;
  }

  .community p {
    font-size: var(--df-text-base);
    color: var(--df-text-muted);
    max-width: 60ch;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--df-navy);
    color: var(--df-cream);
    text-decoration: none;
    border-radius: var(--df-radius-sm);
    font-weight: 600;
    font-size: var(--df-text-base);
    transition: background var(--df-dur-fast) var(--df-ease);
  }
  .btn-primary:hover {
    background: var(--df-teal);
    color: var(--df-cream);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: var(--df-navy);
    border: 1px solid rgba(31, 78, 102, 0.25);
    border-radius: var(--df-radius-sm);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--df-text-base);
    margin-top: 1rem;
    transition: background var(--df-dur-fast) var(--df-ease), border-color var(--df-dur-fast) var(--df-ease);
  }
  .btn-ghost:hover {
    background: rgba(31, 78, 102, 0.06);
    border-color: rgba(31, 78, 102, 0.4);
  }
</style>
